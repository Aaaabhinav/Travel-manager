# ==============================================================================
# Travel & Trip Management Platform — Environment Configuration
# Copy this file to .env and fill in the values
# ==============================================================================

# ---- General ----
COMPOSE_PROJECT_NAME=travel-management

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ISSUER=travel-platform
JWT_EXPIRATION_HOURS=24

# ---- MySQL (User Service) ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=user_service_db
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=user_service
MYSQL_PASSWORD=user_service_pass

# ---- PostgreSQL (Trip & Booking Services) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pass
TRIP_DB_NAME=trip_service_db
BOOKING_DB_NAME=booking_service_db

# ---- Cassandra (Recommendation Service) ----
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=recommendation_service
CASSANDRA_DC=datacenter1

# ---- Redis (Route Service) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
ROUTE_CACHE_TTL_SECONDS=3600

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=travel
RABBITMQ_PASSWORD=travel_pass
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=travel.events

# ---- Kong ----
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# ---- Service Ports (internal) ----
USER_SERVICE_PORT=8081
TRIP_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083
RECOMMENDATION_SERVICE_PORT=8084
ROUTE_SERVICE_PORT=8085

# ---- Saga / Recovery Settings ----
SAGA_STEP_TIMEOUT_SECONDS=30
SAGA_MAX_RETRIES=3
SAGA_RETRY_BACKOFF_MS=1000
OUTBOX_POLL_INTERVAL_MS=500
SAGA_RECOVERY_INTERVAL_SECONDS=60
ENABLE_FAILURE_INJECTION=false

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api
FRONTEND_PORT=3000

# ---- CORS ----
CORS_ALLOWED_ORIGIN=http://localhost:3000
